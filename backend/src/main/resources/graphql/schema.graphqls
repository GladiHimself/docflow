type FileRecord {
    id: ID!
    fileName: String!
    fileType: String!
    status: FileStatus!
    recordCount: Int
    notes: String
    uploadedAt: String!
    processedAt: String
    s3Key: String
}

enum FileStatus {
    UPLOADED
    PROCESSING
    PROCESSED
    FAILED
}

type UploadRequest {
    fileId: ID!
    uploadUrl: String!
    s3Key: String!
}

type Query {
    getAllFiles: [FileRecord!]!
    getFile(id: ID!): FileRecord
    getFilesByStatus(status: FileStatus!): [FileRecord!]!
}

type Mutation {
    requestUpload(fileName: String!, fileType: String!): UploadRequest!
    createFile(fileName: String!, fileType: String!): FileRecord!
    updateFileStatus(id: ID!, status: FileStatus!): FileRecord
    deleteFile(id: ID!): Boolean
    updateFileByS3Key(s3Key: String!, recordCount: Int!): FileRecord
    generateDownloadUrl(s3Key: String!): String!
}